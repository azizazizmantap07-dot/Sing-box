<?xml version="1.0" encoding="utf-8"?>
<!--
  Neutral frosted glass card / pill for the expanded traffic notification: profile (config) card,
  status + uptime card and the "Link" health card all share it, so the three read as one family
  next to the Stop pill.

  Same construction as the chips and tiles: a tinted body with a hairline rim, plus a top sheen.
  The radius is 16dp: a full pill at 32dp, and it clamps to half the height for the smaller 26dp
  profile card (GradientDrawable never rounds more than half the shorter side).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Tinted glass with a hairline rim -->
  <item>
    <shape android:shape="rectangle">
      <corners android:radius="16dp" />
      <gradient
        android:angle="270"
        android:endColor="@color/notif_health_pill_bottom"
        android:startColor="@color/notif_health_pill_top"
        android:type="linear" />
      <stroke
        android:width="0.75dp"
        android:color="@color/notif_health_pill_stroke" />
    </shape>
  </item>
  <!-- Top sheen -->
  <item
    android:bottom="1dp"
    android:left="1dp"
    android:right="1dp"
    android:top="1dp">
    <shape android:shape="rectangle">
      <corners android:radius="16dp" />
      <gradient
        android:angle="270"
        android:endColor="@color/notif_sheen_end"
        android:startColor="@color/notif_sheen_top"
        android:type="linear" />
    </shape>
  </item>
</layer-list>
