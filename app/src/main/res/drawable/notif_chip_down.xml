<?xml version="1.0" encoding="utf-8"?>
<!-- Download speed chip (collapsed view): green tinted glass pill. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Tinted glass with a hairline rim -->
  <item>
    <shape android:shape="rectangle">
      <corners android:radius="16dp" />
      <gradient
        android:angle="270"
        android:endColor="@color/notif_down_bottom"
        android:startColor="@color/notif_down_top"
        android:type="linear" />
      <stroke
        android:width="0.75dp"
        android:color="@color/notif_down_stroke" />
    </shape>
  </item>
  <!-- Top sheen -->
  <item
    android:bottom="1dp"
    android:left="1dp"
    android:right="1dp"
    android:top="1dp">
    <shape android:shape="rectangle">
      <corners android:radius="16dp" />
      <gradient
        android:angle="270"
        android:endColor="@color/notif_sheen_end"
        android:startColor="@color/notif_sheen_top"
        android:type="linear" />
    </shape>
  </item>
</layer-list>
